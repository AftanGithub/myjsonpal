---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/styles/global.css';
import Navbar from '@/components/Navbar.tsx';
import Footer from '@/components/Footer.tsx';
import AdSlot from '@/components/AdSlot.tsx';
import SEO from '@/components/SEO.astro';
import { SITE } from '@/config/site';
import type { ToolConfig } from '@/config/tools';

interface Props {
  tool?: ToolConfig;
  title?: string;
  description?: string;
  keywords?: string[];
  path?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const { tool, title, description, keywords, path = '/', ogImageAlt, noindex } = Astro.props;
const currentPath = tool ? tool.path : path;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          document.documentElement.classList.toggle('dark', theme !== 'light');
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9YWY6H99FR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-9YWY6H99FR');
    </script>
    <SEO tool={tool} title={title} description={description} keywords={keywords} path={currentPath} ogImageAlt={ogImageAlt} noindex={noindex} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    {
      SITE.showAds &&
        import.meta.env.PUBLIC_ADSENSE_CLIENT && (
          <script is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}
            crossorigin="anonymous"
          />
        )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <AdSlot variant="leaderboard" className="container-site mt-4" />
    <Navbar pathname={currentPath} client:load />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
