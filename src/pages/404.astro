---
import MinimalLayout from '@/layouts/MinimalLayout.astro';
import { TOOL_LIST } from '@/config/tools';
import logo from '@/assets/logo-mark.png';
---

<MinimalLayout
  title="Page Not Found | myJSONPal"
  description="The page you are looking for does not exist or has been moved. Explore myJSONPal's free JSON formatter, validator, and converter tools."
  keywords={['page not found', '404', 'json tools']}
  path="/404/"
  noindex
  ogImageAlt="myJSONPal — page not found"
>
  <header class="container-site flex items-center py-6">
    <a href="/" class="flex items-center gap-2" aria-label="myJSONPal home">
      <img
        src={logo.src}
        alt="myJSONPal logo"
        class="h-7 w-7"
        width={128}
        height={128}
      />
      <span class="text-[15px] font-semibold tracking-tight text-ink">
        myjson<span class="text-mute">pal</span>
      </span>
    </a>
  </header>

  <main class="flex flex-1 flex-col">
    <section class="mesh-hero relative flex flex-1 flex-col items-center justify-center overflow-hidden px-4 py-16 text-center">
      <div class="relative w-full max-w-2xl">
        <p class="eyebrow">Error 404</p>
        <h1 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl">
          Page not found
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-[15px] leading-relaxed text-body sm:text-base">
          The page you are looking for does not exist or has been moved. Let's get you back on
          track.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="btn-primary">Back to Home</a>
          <a href="/contact/" class="btn-ghost">Contact Us</a>
        </div>

        <div class="mt-14">
          <h2 class="eyebrow">Popular tools</h2>
          <ul class="mt-4 flex flex-wrap justify-center gap-2">
            {TOOL_LIST.map((tool) => (
              <li class="min-w-0 max-w-full">
                <a
                  href={tool.path}
                  title={tool.h1}
                  class="chip w-full truncate transition-colors hover:border-accent hover:text-accent"
                >
                  {tool.h1}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>
</MinimalLayout>
